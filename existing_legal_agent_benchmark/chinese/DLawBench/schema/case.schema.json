{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "jurisdiction",
    "language",
    "opening",
    "facts",
    "evaluation_criteria",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "CN",
        "US"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "zh",
        "en"
      ]
    },
    "opening": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "client_belief",
          "court_record",
          "gap_type"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "client_belief": {
            "type": "string"
          },
          "court_record": {
            "type": "string"
          },
          "gap_type": {
            "type": "string",
            "enum": [
              "disputed",
              "undisputed"
            ]
          }
        }
      }
    },
    "evaluation_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_inquiries",
        "memo_expectations"
      ],
      "properties": {
        "expected_inquiries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "memo_expectations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
